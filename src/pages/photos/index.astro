---
import Base from '../../layouts/Base.astro';
import CroppedImage from '../../components/CroppedImage.astro';
import { getCollection } from 'astro:content';

const photos = (await getCollection('photos'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getAspectRatio(photo: typeof photos[0]) {
  const [_x, _y, w, h] = photo.data.cropArea.split(' ').map(v => parseFloat(v));
  return (w * photo.data.image.width) / (h * photo.data.image.height);
}

const aspectRatios = photos.map(p => getAspectRatio(p));
const fullAspectRatios = photos.map(p => p.data.image.width / p.data.image.height);

// Masonry positions are computed here so the grid is laid out by CSS before any
// script runs. Each photo goes into the shortest column (as the old client script
// did); its top is stored as a multiple of the column width plus a count of gaps,
// which CSS turns into pixels with container query units at any width.
const GAP = 16;
type Slot = { col: number; u: number; n: number };
function masonry(aspects: number[], cols: number, nominalColWidth: number) {
  const units = new Array(cols).fill(0);
  const gaps = new Array(cols).fill(0);
  const height = (c: number) => units[c] * nominalColWidth + gaps[c] * GAP;
  const slots: Slot[] = aspects.map((aspect) => {
    const heights = units.map((_, c) => height(c));
    const col = heights.indexOf(Math.min(...heights));
    const slot = { col, u: units[col], n: gaps[col] };
    units[col] += 1 / aspect;
    gaps[col] += 1;
    return slot;
  });
  const tallest = units.map((_, c) => height(c)).reduce((best, h, c, all) => (h > all[best] ? c : best), 0);
  return { slots, total: { u: units[tallest], n: gaps[tallest] } };
}

// Column widths at typical sizes for each breakpoint; they only break near-ties.
const layouts = {
  m2c: masonry(aspectRatios, 2, 440),
  m3c: masonry(aspectRatios, 3, 507),
  m2f: masonry(fullAspectRatios, 2, 440),
  m3f: masonry(fullAspectRatios, 3, 507),
};
const cardVars = (i: number) => Object.entries(layouts)
  .map(([name, { slots }]) => `--${name}-col: ${slots[i].col}; --${name}-u: ${slots[i].u}; --${name}-n: ${slots[i].n};`)
  .join(' ');
const gridVars = Object.entries(layouts)
  .map(([name, { total }]) => `--${name}-hu: ${total.u}; --${name}-hn: ${total.n};`)
  .join(' ');

// One column on phones, two up to 1024px, then three inside the 1600px page.
const gridSizes = '(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc(50vw - 32px), (max-width: 1600px) calc(33.34vw - 27px), 507px';
---

<Base title="Photos - Rhys Sullivan" description="Astrophotography and space photos." wide>
  <div class="photo-page">
    <header class="photo-header">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight mb-2">space photos</h1>
        <p class="text-balance text-[var(--text-muted)]">
          captured in san francisco using my <a href="https://amzn.to/49FP2sh" target="_blank" class="whitespace-nowrap underline hover:text-[var(--text)] transition-colors">dwarf 3</a>
        </p>
      </div>
      {photos.length > 0 && (
        <div class="photo-view-toggle" role="group" aria-label="Photo framing">
          <button type="button" data-photo-view="cropped" aria-pressed="true" aria-controls="photo-grid">Cropped</button>
          <button type="button" data-photo-view="uncropped" aria-pressed="false" aria-controls="photo-grid">Uncropped</button>
        </div>
      )}
    </header>

    {photos.length === 0 ? (
      <p class="text-[var(--text-muted)]">photos coming soon</p>
    ) : (
      <div id="photo-grid" data-view="cropped" style={gridVars}>
        {photos.map((photo, i) => (
          <a
            href={`/photos/${photo.slug}`}
            class="photo-card group block rounded-lg"
            data-index={i}
            style={cardVars(i)}
          >
            <figure class="photo-figure">
              <div class="overflow-hidden rounded-lg bg-[var(--bg-secondary)]">
                <CroppedImage
                  src={photo.data.image}
                  alt={photo.data.alt}
                  cropArea={photo.data.cropArea}
                  sizes={gridSizes}
                  class="w-full"
                  eager={i < 3}
                  priority={i === 0}
                  uncropped
                />
              </div>
              <figcaption class="photo-details">
                <h3 class="photo-title">{photo.data.title}</h3>
                <time class="photo-date" datetime={photo.data.date.toISOString().slice(0, 10)}>
                  {photo.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </figcaption>
            </figure>
          </a>
        ))}
      </div>
    )}
  </div>
  
  <style>
    .photo-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 24px;
    }
    /* Phones: one column in normal flow, captions under each photo. */
    #photo-grid {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .photo-card:focus-visible {
      outline: 2px solid var(--text);
      outline-offset: 4px;
    }
    .photo-figure {
      position: relative;
    }
    .photo-details {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 2px 0;
    }
    .photo-title {
      font-size: 0.875rem;
      line-height: 1.25rem;
      font-weight: 500;
    }
    .photo-date {
      flex-shrink: 0;
      font-size: 0.75rem;
      line-height: 1rem;
      color: var(--text-muted);
    }
    /* Wider screens: masonry columns placed from the build-time layout, captions sit over the photo. */
    .photo-page {
      container-type: inline-size;
    }
    @media (min-width: 640px) {
      #photo-grid {
        display: block;
        --cols: 2;
        --hu: var(--m2c-hu);
        --hn: var(--m2c-hn);
      }
      #photo-grid[data-view='uncropped'] {
        --hu: var(--m2f-hu);
        --hn: var(--m2f-hn);
      }
      #photo-grid,
      .photo-card {
        --col-width: calc((100cqw - (var(--cols) - 1) * 16px) / var(--cols));
      }
      #photo-grid {
        height: calc(var(--hu) * var(--col-width) + var(--hn) * 16px);
      }
      .photo-card {
        --col: var(--m2c-col);
        --u: var(--m2c-u);
        --n: var(--m2c-n);
        position: absolute;
        width: var(--col-width);
        left: calc(var(--col) * (var(--col-width) + 16px));
        top: calc(var(--u) * var(--col-width) + var(--n) * 16px);
      }
      #photo-grid[data-view='uncropped'] .photo-card {
        --col: var(--m2f-col);
        --u: var(--m2f-u);
        --n: var(--m2f-n);
      }
      .photo-details {
        position: absolute;
        inset: auto 0 0 0;
        z-index: 10;
        display: block;
        padding: 48px 16px 16px;
        border-radius: 0 0 0.5rem 0.5rem;
        background: linear-gradient(to top, rgb(0 0 0 / 80%), transparent);
        pointer-events: none;
        transition: opacity 220ms ease, transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .photo-title {
        color: white;
      }
      .photo-date {
        color: rgb(255 255 255 / 70%);
      }
    }
    @media (min-width: 1024px) {
      #photo-grid {
        --cols: 3;
        --hu: var(--m3c-hu);
        --hn: var(--m3c-hn);
      }
      #photo-grid[data-view='uncropped'] {
        --hu: var(--m3f-hu);
        --hn: var(--m3f-hn);
      }
      .photo-card {
        --col: var(--m3c-col);
        --u: var(--m3c-u);
        --n: var(--m3c-n);
      }
      #photo-grid[data-view='uncropped'] .photo-card {
        --col: var(--m3f-col);
        --u: var(--m3f-u);
        --n: var(--m3f-n);
      }
    }
    @media (min-width: 640px) and (hover: hover) and (pointer: fine) {
      .photo-details {
        opacity: 0;
        transform: translateY(8px);
      }
      .photo-card:hover .photo-details,
      .photo-card:focus-within .photo-details {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .photo-view-toggle {
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: 1fr 1fr;
      flex-shrink: 0;
      margin-left: auto;
      padding: 3px;
      border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
      background: var(--bg-secondary);
      border-radius: 10px;
    }
    .photo-view-toggle::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: 3px auto 3px 3px;
      width: calc((100% - 6px) / 2);
      border-radius: 7px;
      background: color-mix(in srgb, var(--text) 12%, var(--bg));
      box-shadow: 0 1px 3px rgb(0 0 0 / 12%);
      transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .photo-view-toggle:has([data-photo-view="uncropped"][aria-pressed="true"])::before {
      transform: translateX(100%);
    }
    .photo-view-toggle button {
      min-height: 34px;
      padding: 6px 12px;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 500;
      color: var(--text-muted);
      transition: color 160ms ease;
    }
    .photo-view-toggle button[aria-pressed="true"],
    .photo-view-toggle button:hover {
      color: var(--text);
    }
    .photo-view-toggle button:focus-visible {
      outline: 2px solid var(--text);
      outline-offset: 3px;
    }
    @media (pointer: coarse) {
      .photo-view-toggle button {
        min-height: 44px;
      }
    }
    @media (max-width: 639px) {
      .photo-header {
        gap: 16px;
      }
      .photo-view-toggle {
        width: 100%;
        margin-left: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .photo-details,
      .photo-view-toggle::before,
      .photo-view-toggle button {
        transition: none;
      }
    }
  </style>

  <script is:inline>
    // astro:page-load fires on initial load AND after every View Transition
    document.addEventListener('astro:page-load', function() {
      document.querySelectorAll('[data-photo-view]').forEach(button => {
        button.onclick = function() {
          const grid = document.getElementById('photo-grid');
          if (!grid) return;
          grid.dataset.view = button.dataset.photoView;
          document.querySelectorAll('[data-photo-view]').forEach(option => {
            option.setAttribute('aria-pressed', String(option === button));
          });
        };
      });
    });
  </script>
</Base>

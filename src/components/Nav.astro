---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isDev = import.meta.env.DEV;

const links = [
  { href: '/', label: 'home' },
  { href: '/blog', label: 'blog' },
  { href: '/ideas', label: 'ideas' },
  { href: '/notes', label: 'notes' },
  { href: '/projects', label: 'projects' },
  { href: '/photos', label: 'space' },
  { href: '/software-i-like', label: 'software i like' },
];
---

<nav class="flex items-start justify-between gap-4 py-4 sm:py-6">
  <div class="flex flex-wrap items-center gap-x-5 sm:gap-x-6">
    {links.map(({ href, label }) => (
      <a
        href={href}
        class:list={[
          'py-2 text-sm whitespace-nowrap transition-colors',
          pathname === href || (href !== '/' && pathname.startsWith(href))
            ? 'text-[var(--text)]'
            : 'text-[var(--text-muted)] hover:text-[var(--text)]',
        ]}
      >
        {label}
      </a>
    ))}
    {isDev && (
      <a
        href="/tools/focal-picker"
        class="py-2 text-sm whitespace-nowrap text-yellow-500 hover:text-yellow-400 transition-colors"
      >
        [focal picker]
      </a>
    )}
  </div>
  <ThemeToggle />
</nav>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  cropArea: string;
  class?: string;
}

const { src, alt, cropArea, class: className } = Astro.props;

const [x, y, w, h] = cropArea.split(' ').map(v => parseFloat(v));

const scaleX = 100 / w;
const scaleY = 100 / h;
const offsetX = -x * scaleX;
const offsetY = -y * scaleY;

const aspectRatio = (w * src.width) / (h * src.height);
const imageWidths = [...new Set([400, 800, 1200, 1600, 2400, src.width])]
  .filter(width => width <= src.width)
  .sort((a, b) => a - b);
const imageSizes = `(max-width: 1023px) ${50 * scaleX}vw, ${500 * scaleX}px`;
---

<div 
  data-crop-frame
  class:list={["overflow-hidden relative", className]}
  style={`aspect-ratio: ${aspectRatio}; --full-aspect: ${src.width / src.height};`}
>
  <Image
    src={src}
    alt={alt}
    class="absolute w-full h-full"
    style={`width: ${scaleX * 100}%; height: ${scaleY * 100}%; left: ${offsetX}%; top: ${offsetY}%; max-width: none;`}
    widths={imageWidths}
    sizes={imageSizes}
    quality={100}
  />
</div>

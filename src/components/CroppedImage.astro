---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { cropRegion, parseCrop } from '../lib/image-service';

interface Props {
  src: ImageMetadata;
  alt: string;
  cropArea: string;
  /** Rendered width of the frame, as an <img sizes> value. */
  sizes: string;
  class?: string;
  /** Load immediately instead of lazily. */
  eager?: boolean;
  /** Fetch ahead of other images; implies eager. */
  priority?: boolean;
  /** Also render the whole frame, shown when an ancestor has data-view="uncropped". */
  uncropped?: boolean;
}

const { src, alt, cropArea, sizes, class: className, eager = false, priority = false, uncropped = false } = Astro.props;

const WIDTHS = [480, 720, 960, 1200];
const QUALITY = 90;

const crop = parseCrop(cropArea);
const region = cropRegion(cropArea, src.width, src.height);
const isWholeFrame = region.width === src.width && region.height === src.height;
const cropAspect = (crop.w * src.width) / (crop.h * src.height);
const fullAspect = src.width / src.height;

async function srcset(maxWidth: number, cropOption: string | undefined) {
  const largest = Math.min(maxWidth, WIDTHS[WIDTHS.length - 1]);
  const widths = [...WIDTHS.filter(width => width < largest), largest];
  const images = await Promise.all(widths.map(width => getImage({
    src,
    width,
    format: 'webp',
    quality: QUALITY,
    ...(cropOption ? { crop: cropOption } : {}),
  })));
  return {
    src: images[images.length - 1].src,
    srcset: images.map((image, i) => `${image.src} ${widths[i]}w`).join(', '),
  };
}

const croppedImage = await srcset(region.width, isWholeFrame ? undefined : cropArea);
const fullImage = uncropped ? await srcset(src.width, undefined) : null;
const immediate = eager || priority;
---

<div
  data-crop-frame
  class:list={["overflow-hidden relative", className]}
  style={`--crop-aspect: ${cropAspect}; --full-aspect: ${fullAspect};`}
>
  <img
    data-photo-frame="cropped"
    src={croppedImage.src}
    srcset={croppedImage.srcset}
    sizes={sizes}
    alt={alt}
    width={region.width}
    height={region.height}
    loading={immediate ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
  />
  {fullImage && (
    <img
      data-photo-frame="uncropped"
      src={fullImage.src}
      srcset={fullImage.srcset}
      sizes={sizes}
      alt={alt}
      width={src.width}
      height={src.height}
      loading="lazy"
      decoding="async"
    />
  )}
</div>

<style>
  [data-crop-frame] {
    aspect-ratio: var(--crop-aspect);
  }
  [data-photo-frame] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A hidden lazy image is not fetched, so the whole frame only loads once asked for. */
  [data-photo-frame='uncropped'] {
    display: none;
  }
  :global([data-view='uncropped']) [data-crop-frame] {
    aspect-ratio: var(--full-aspect);
  }
  :global([data-view='uncropped']) [data-photo-frame='cropped'] {
    display: none;
  }
  :global([data-view='uncropped']) [data-photo-frame='uncropped'] {
    display: block;
  }
</style>
